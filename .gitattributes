# Line endings: normalise in the repo, keep LF on disk (docs/CONTRIBUTING.md).
* text=auto eol=lf

# Binaries
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.ico binary

# Generated by tools/asset-pipeline — review the pipeline, not the diff
public/assets/** linguist-generated=true
public/icons/** linguist-generated=true
assets/source/** linguist-generated=true
docs/preview/** linguist-generated=true
package-lock.json linguist-generated=true
